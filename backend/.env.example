# Keep all credentials in this backend-only file.
PORT=5000
MONGODB_URI=
JWT_SECRET=
DEMO_MENTOR_PASSWORD=
DEMO_PARENT_PASSWORD=

# Email (Brevo HTTP API).
# Leave BREVO_API_KEY unset to skip sending in local dev — emails are logged instead.
# Get the key from https://app.brevo.com/settings/keys/api
# The From address must be verified under "Senders, domains, IPs" in Brevo.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=MentorMatch